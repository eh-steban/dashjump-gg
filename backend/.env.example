# JWT -- generate a long random string for JWT_SECRET_KEY
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet -- must be 32 url-safe base64 bytes.
# Generated automatically by `scripts/wt create`.
# Generate manually: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_SECRET_KEY=changeme

POSTGRES_USER=deadlock
POSTGRES_PASSWORD=deadlockpass
POSTGRES_DB=deadlock_db
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@dashjump-db:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@dashjump-db:5432/deadlock_test_db

DEADLOCK_API_KEY=changeme
DEADLOCK_API_DOMAIN=https://api.deadlock-api.com

FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
PARSER_BASE_URL=http://dashjump-parser:9000

STEAM_WEB_API_KEY=changeme
STEAM_HASH_SALT=changeme
